PORT=3000
NODE_ENV=development

RIOT_API_KEY=RGAPI-your-key-here
RIOT_PLATFORM=vn2
RIOT_REGION=sea
RIOT_IDS=
MATCHES_PER_PLAYER=20

# Discord bot
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-application-id
# Nếu đặt GUILD_ID: bot đăng ký duy nhất /notify cho guild này và tự dọn các command WebLienMinh cũ ở global scope.
# Nếu để trống: bot dùng /notify global và khi online sẽ dọn command WebLienMinh cũ ở guild scope trong các server bot đang tham gia.
DISCORD_GUILD_ID=
# Website/API hiện tại của bot. Không cần thêm #dashboard vì hash chỉ dùng phía trình duyệt.
WEB_API_URL=https://metalienminh.up.railway.app

# Discord Riot News / Event auto notification
# Channel bot sẽ tự gửi tin mới.
DISCORD_NEWS_CHANNEL_ID=
# Role mặc định được tag nếu category không có role riêng.
DISCORD_NEWS_ROLE_ID=
# Role riêng theo từng loại; để trống sẽ fallback về DISCORD_NEWS_ROLE_ID.
DISCORD_PATCH_ROLE_ID=
DISCORD_SKIN_ROLE_ID=
DISCORD_HALL_ROLE_ID=
DISCORD_EVENT_ROLE_ID=
DISCORD_ESPORTS_ROLE_ID=
DISCORD_CHAMPION_ROLE_ID=
# Các nhóm bot tự theo dõi. Có thể bỏ bớt nếu server không muốn nhận quá nhiều.
DISCORD_NOTIFY_TYPES=patch,skin,hall,event,esports,champion
# Bot kiểm tra nguồn chính thức Riot mỗi N phút. Tối thiểu 5 phút.
NEWS_CHECK_INTERVAL_MINUTES=10
# Mặc định false để restart/deploy bot không spam lại các bài cũ.
BOT_NOTIFY_ON_STARTUP=false
# Nếu Railway có Volume, có thể đặt /data/bot-news-state.json để giữ state qua redeploy.
BOT_STATE_FILE=.bot-news-state.json

# Global Meta Movement + Champion Balance Alert
# Để trống sẽ dùng chung DISCORD_NEWS_CHANNEL_ID / DISCORD_NEWS_ROLE_ID.
DISCORD_META_CHANNEL_ID=
DISCORD_META_ROLE_ID=
# Quét dataset Global High-Elo; tối thiểu 15 phút. Meta hiện update theo pipeline riêng nên 30 phút là đủ.
META_CHECK_INTERVAL_MINUTES=30
# Báo khi Tier đổi, hoặc Tier Score / Win Rate thay đổi vượt ngưỡng dưới đây.
META_SCORE_DELTA_THRESHOLD=5
META_WINRATE_DELTA_THRESHOLD=1.5
# Bỏ qua tướng có sample quá nhỏ ở một trong hai snapshot.
META_MIN_GAMES=10
# Mặc định false: deploy lần đầu chỉ lấy patch hiện tại làm baseline, không spam Balance Alert cũ.
BALANCE_NOTIFY_ON_STARTUP=false
# Nếu Railway có Volume, nên dùng /data/bot-meta-state.json.
META_STATE_FILE=.bot-meta-state.json
